{
  "name": "@food-log/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "food-log PWA（Vite + React + TS + Tailwind v4；後端 Apps Script）",
  "scripts": {
    "sync-tokens": "node ../../packages/ui/scripts/sync-tokens.mjs",
    "predev": "node ../../packages/ui/scripts/sync-tokens.mjs",
    "dev": "vite --host",
    "prebuild": "node ../../packages/ui/scripts/sync-tokens.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "build:catalog": "node scripts/build-catalog.mjs",
    "e2e": "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 PLAYWRIGHT_DIR=/workspace/photo-repro/node_modules/playwright node e2e/real-click.mjs"
  },
  "dependencies": {
    "@food-log/ui": "workspace:*",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2",
    "workbox-window": "7.4.1"
  }
}
