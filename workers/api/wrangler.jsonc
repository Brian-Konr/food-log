{
  // food-log v2 Worker: API + cron export + the PWA as static assets. Nothing here is a secret.
  "name": "food-log",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // DEPLOY ONLY WITH `pnpm run deploy` (or its alias `deploy:with-app`), never a plain `wrangler deploy`.
  // This file has no `assets` on purpose (wrangler dev, d1 and the ops scripts read it and must not need a built
  // apps/food-log/dist), so a plain `wrangler deploy` would ship the Worker WITHOUT the frontend and take the live
  // PWA down. scripts/deploy-with-app.ts builds the app and deploys a generated copy of this file with the assets
  // added (apps/food-log/dist, SPA fallback, Worker first on the API paths); `--var` / `--message` go through it too.

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "food-log",
      // printed by `wrangler d1 create food-log` on 2026-10-16 (APAC; not a secret). Local dev and tests use wrangler.test.jsonc / --local.
      "database_id": "063b042c-76a4-4e2e-9707-9f869f5080d3",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "EXPORTS",
      // ⛔ Brian: `wrangler r2 bucket create food-log-exports` (R2 may ask for a card on the free plan, plan section 8).
      "bucket_name": "food-log-exports"
    }
  ],

  // POST /telemetry/error is public: per-IP limit with the Workers Rate Limiting binding (10 requests / 60 s per IP).
  // namespace_id is just a number you pick, unique inside your account. Without the binding the Worker falls back to
  // a per-isolate token bucket (src/routes/telemetry.ts).
  "ratelimits": [{ "name": "TELEMETRY_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],

  // Daily export (src/cron/export.ts): "0 20 * * *" = 04:00 Taipei starts it; "*/5 20 * * *" = every 5 minutes up to 04:55 Taipei
  // resumes an unfinished one (progress lives in the D1 table export_progress; the minute-0 tick of the second cron is skipped).
  // 2 of the free plan's 5 cron triggers.
  "triggers": { "crons": ["0 20 * * *", "*/5 20 * * *"] },

  // Only the workers.dev host serves the Worker: preview URLs have other hostnames, where APP_ORIGIN / passkeys cannot work.
  // (Same shape as the phase-0 spike, which ran on food-log-spike.brian-konr.workers.dev.)
  "workers_dev": true,
  "preview_urls": false,

  "vars": {
    // reject push from clients older than this with 409 client_too_old (rollback: set 9999)
    "MIN_CLIENT_VERSION": "1",
    // rows one export invocation processes before leaving the rest to the next 5-minute resume tick (one chunk = 1000 rows)
    "EXPORT_ROW_BUDGET": "3000",
    // The passkey origin (the RP ID is its hostname: food-log.brian-konr.workers.dev). Not a secret. MANDATORY once deployed: the Worker
    // answers 500 'APP_ORIGIN not configured' on /api/auth/*, /sync/* and /bot/* without it; only localhost may omit it.
    // It is also what lets Better Auth be built at Worker startup (src/auth.ts) instead of on the first request.
    // For `wrangler dev --local`, override it with an empty value in workers/api/.dev.vars (APP_ORIGIN=) so local auth derives
    // the localhost origin from the request instead.
    "APP_ORIGIN": "https://food-log.brian-konr.workers.dev"
  }

  // Secrets (never in git; set with `wrangler secret put <NAME>`):
  //   BETTER_AUTH_SECRET  random value, e.g. `openssl rand -base64 32`
  //   ALLOWED_EMAILS      comma separated owner emails (the only addresses that can ever get a session)
}
