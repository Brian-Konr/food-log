{
  // food-log v2 Worker: API + cron export (+ the PWA as static assets once Phase 2 lands, see deploy:with-app). Nothing here is a secret.
  "name": "food-log",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // API ONLY, no static assets: `pnpm run deploy` ships just the Worker. The apps/food-log frontend is still v1
  // (src/api/gas.ts talks to Apps Script) and must not be published here. `pnpm run deploy:with-app`
  // (scripts/deploy-with-app.ts) adds the PWA assets (apps/food-log/dist, SPA fallback, Worker first on the API paths)
  // to a generated copy of this file, and refuses until apps/food-log no longer contains src/api/gas.ts (Phase 2).

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "food-log",
      // ⛔ Brian: replace with the id printed by `wrangler d1 create food-log` (not a secret).
      // The placeholder is fine for `wrangler dev --local` and the tests.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "EXPORTS",
      // ⛔ Brian: `wrangler r2 bucket create food-log-exports` (R2 may ask for a card on the free plan, plan section 8).
      "bucket_name": "food-log-exports"
    }
  ],

  // POST /telemetry/error is public: per-IP limit with the Workers Rate Limiting binding (10 requests / 60 s per IP).
  // namespace_id is just a number you pick, unique inside your account. Without the binding the Worker falls back to
  // a per-isolate token bucket (src/routes/telemetry.ts).
  "ratelimits": [{ "name": "TELEMETRY_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],

  // Daily export at 20:00 UTC = 04:00 Taipei (src/cron/export.ts)
  "triggers": { "crons": ["0 20 * * *"] },

  "vars": {
    // reject push from clients older than this with 409 client_too_old (rollback: set 9999)
    "MIN_CLIENT_VERSION": "1",
    // ⛔ Brian: APP_ORIGIN is MANDATORY once deployed. The Worker answers 500 'APP_ORIGIN not configured' on
    // /api/auth/*, /sync/* and /bot/* without it; only localhost may omit it. It is the passkey origin
    // (the RP ID is its hostname). After the first deploy prints https://food-log.<your-subdomain>.workers.dev,
    // replace the empty value below with that origin and deploy again. Not a secret. Keep it empty for `wrangler dev --local`.
    "APP_ORIGIN": ""
  }

  // Secrets (never in git; set with `wrangler secret put <NAME>`):
  //   BETTER_AUTH_SECRET  random value, e.g. `openssl rand -base64 32`
  //   ALLOWED_EMAILS      comma separated owner emails (the only addresses that can ever get a session)
}
