{
  "name": "@food-log/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "food-log v2 Worker：Hono + Better Auth（passkey / 登入碼 / Bot API key）+ D1（CAS batch）+ R2 每日匯出 + static assets",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev": "wrangler dev --local",
    "db:migrate:local": "wrangler d1 migrations apply food-log --local",
    "db:migrate:remote": "wrangler d1 migrations apply food-log --remote",
    "build:web": "pnpm --filter @food-log/app build",
    "deploy": "pnpm -r typecheck && pnpm -r test && pnpm run build:web && wrangler d1 migrations apply food-log --remote && wrangler deploy"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.10",
    "@better-auth/passkey": "1.7.10",
    "@food-log/core": "workspace:*",
    "@hono/zod-openapi": "1.6.3",
    "better-auth": "1.7.10",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.3",
    "@cloudflare/workers-types": "5.20261015.1",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.151.0"
  }
}
